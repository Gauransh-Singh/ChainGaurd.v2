{
  "requires": {
    "db": {
      "kind": "sqlite",
      "credentials": {
        "url": "db.sqlite"
      },
      "[production]": {
        "kind": "hana",
        "deploy-format": "hdbtable"
      },
      "[hybrid]": {
        "kind": "hana",
        "binding": {
          "type": "hana"
        }
      }
    }
  },
  "protocols": {
    "odata-v4": {
      "path": "/chain-guard"
    }
  },
  "cors": {
    "origin": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8000",
      "http://192.168.1.5:5173"
    ],
    "credentials": true
  }
}